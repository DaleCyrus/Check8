FLASK_ENV=production
SECRET_KEY=your-super-strong-secret-key-change-this-to-something-random
# Replace the placeholders with the Session pooler values from Supabase Connect.
# On Render, configure DATABASE_URL in the web service's Environment settings.
DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@YOUR_POOLER_HOST:5432/postgres?sslmode=require
